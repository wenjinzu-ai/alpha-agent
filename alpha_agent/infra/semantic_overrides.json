    "filters": {
      "today": "trade_date = (SELECT MAX(trade_date) FROM daily_kline)",
      "this_week": "trade_date >= (SELECT MAX(trade_date)::date - INTERVAL '5 days' FROM daily_kline)",
      "this_month": "trade_date >= (SELECT MAX(trade_date)::date - INTERVAL '30 days' FROM daily_kline)",
      "active_stocks": "ts_code IN (SELECT ts_code FROM stocks WHERE is_active = true)"
    },
    "business_formulas": {
      "涨跌家数": "COUNT(CASE WHEN pct_chg>0 THEN 1 END) AS 上涨家数, COUNT(CASE WHEN pct_chg<0 THEN 1 END) AS 下跌家数",
      "平均涨跌幅": "AVG(pct_chg) AS 平均涨跌幅",
      "涨跌停家数": "COUNT(CASE WHEN pct_chg>=9.9 THEN 1 END) AS 涨停家数, COUNT(CASE WHEN pct_chg<=-9.9 THEN 1 END) AS 跌停家数"
    }
