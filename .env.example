# ===== 应用配置 =====
APP_NAME=Alpha Agent
DEBUG=false
LOG_LEVEL=INFO

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=alpha_agent

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=false
# REDIS_PASSWORD=

# ===== Tushare =====
# TUSHARE_TOKEN=your_token_here

# ===== 搜索 API =====
# Tavily: AI Agent 专用搜索，国内可直接访问，免费 1000 次/月
# 申请地址: https://tavily.com
# TAVILY_API_KEY=tvly-xxxxx

# 博查 AI: 国内搜索 API，支持中文搜索和智能摘要
# 申请地址: https://open.bochaai.com
# BOCHA_API_KEY=sk-xxxxx

# Bing 搜索 API（需微软 Azure 订阅）
# BING_API_KEY=xxxxx

# 搜索代理（可选，用于 DuckDuckGo 等需要翻墙的搜索源）
# SEARCH_PROXY=http://127.0.0.1:7890

# 自建 SearXNG 实例（可选，替代公共实例）
# SEARXNG_URL=http://localhost:8888

# ===== 调度器 =====
SCHEDULER_ENABLED=false
SYNC_STOCK_LIST_TIME="0 8 * * 1-5"
SYNC_STOCK_KLINE_TIME="0 17 * * 1-5"
SYNC_ETF_LIST_TIME="0 8 * * 1-5"
SYNC_ETF_KLINE_TIME="30 17 * * 1-5"