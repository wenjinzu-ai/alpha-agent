# ===== 应用配置 =====
APP_NAME=Investment Agent
DEBUG=false
LOG_LEVEL=INFO

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=investment_agent

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=false
# REDIS_PASSWORD=

# ===== Tushare =====
# TUSHARE_TOKEN=your_token_here

# ===== 调度器 =====
SCHEDULER_ENABLED=false
SYNC_STOCK_LIST_TIME="0 8 * * 1-5"
SYNC_STOCK_KLINE_TIME="0 17 * * 1-5"
SYNC_ETF_LIST_TIME="0 8 * * 1-5"
SYNC_ETF_KLINE_TIME="30 17 * * 1-5"
